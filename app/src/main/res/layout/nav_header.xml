<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="190dp"
    android:background="#001F3F"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Circular Badge for the Boat Icon -->
    <ImageView
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:background="@drawable/severity_badge_bg"
        android:padding="12dp"
        android:src="@drawable/fishing_boat"
        android:tint="#001F3F" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vessel Commander"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ID: SEASENTRY-PRO-2026"
        android:textColor="#B3E5FC"
        android:textSize="12sp"
        android:letterSpacing="0.1"/>
</LinearLayout>